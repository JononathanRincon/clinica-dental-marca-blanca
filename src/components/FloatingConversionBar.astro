---
import { SITE_CONFIG } from '../config/site';
---

<!-- 1. BARRA FIJA INFERIOR DE ALTA CONVERSIÓN MÓVIL (< lg): 35% Llamar + 65% WhatsApp con Badge "1" -->
<div class="lg:hidden fixed bottom-0 left-0 w-full z-[990] bg-surface-container-lowest border-t border-surface-variant shadow-[0_-4px_20px_rgba(0,0,0,0.08)] px-3.5 py-2.5 flex items-center gap-2.5">
  <!-- Botón Izquierdo (35% ancho) -->
  <a
    class="w-[35%] h-12 bg-surface-container hover:bg-surface-variant text-on-surface font-title-md text-body-md font-bold rounded-lg flex items-center justify-center whitespace-nowrap shadow-sm no-underline"
    href={SITE_CONFIG.links.phoneCall}
  >
    📞 Llamar
  </a>

  <!-- Botón Derecho WhatsApp (65% ancho) con micro-notificación "1" -->
  <a
    class="relative w-[65%] h-12 bg-[#25D366] hover:bg-[#1ebe5d] text-white font-title-md text-body-md font-bold rounded-full flex items-center justify-center gap-2 whitespace-nowrap shadow-md no-underline px-3"
    href={SITE_CONFIG.links.whatsappDirect}
    target="_blank"
    rel="noopener noreferrer"
  >
    <svg class="w-5 h-5 fill-current shrink-0" viewBox="0 0 24 24">
      <path
        d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"
      ></path>
    </svg>
    <span class="relative flex h-2 w-2 shrink-0">
      <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-white opacity-75"></span>
      <span class="relative inline-flex rounded-full h-2 w-2 bg-white"></span>
    </span>
    <span class="truncate">Agendar por WhatsApp</span>
    <!-- Micro-notificación roja "1" -->
    <span class="absolute -top-1.5 -right-1 w-5 h-5 rounded-full bg-[#E53935] text-white font-title-md text-[11px] font-bold flex items-center justify-center shadow border border-white">
      1
    </span>
  </a>
</div>

<!-- 2. BOTÓN FLOTANTE DE WHATSAPP DESKTOP (>= lg) EN ESQUINA INFERIOR DERECHA (bottom-6 right-6) -->
<div class="hidden lg:flex fixed bottom-6 right-6 z-[990] items-center">
  <a
    href={SITE_CONFIG.links.whatsappDirect}
    target="_blank"
    rel="noopener noreferrer"
    class="relative bg-[#25D366] hover:bg-[#1ebe5d] shadow-[0_10px_25px_rgba(37,211,102,0.35)] px-[22px] py-[14px] rounded-full text-white cursor-pointer no-underline flex items-center gap-2.5 whitespace-nowrap transition-transform hover:scale-105"
  >
    <svg class="w-[22px] h-[22px] fill-current shrink-0" viewBox="0 0 24 24">
      <path
        d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"
      ></path>
    </svg>
    <span class="w-2 h-2 rounded-full bg-[#A7F3D0] shadow-[0_0_0_2px_rgba(167,243,208,0.4)] shrink-0"></span>
    <span class="font-body-md text-[14px] font-bold text-white">¿Dudas o Urgencias? Chatea con nosotros</span>
    <span class="absolute -top-1.5 -right-1.5 bg-[#E53935] text-white w-5 h-5 rounded-full text-[11px] font-bold flex items-center justify-center border-2 border-white shadow">
      1
    </span>
  </a>
</div>
