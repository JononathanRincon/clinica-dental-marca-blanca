---
import BookingIsland from './BookingIsland';
import { SITE_CONFIG } from '../config/site';
---

<section class="w-full bg-surface-container-low py-10 lg:py-space-xl" id="agendar">
  <div class="max-w-[1440px] mx-auto px-4 sm:px-margin-mobile lg:px-margin">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-space-xl items-start">
      <!-- Left Column: 60% Width (7 cols) Interactive Booking Form Island -->
      <div class="lg:col-span-7">
        <BookingIsland client:load />
      </div>

      <!-- Right Column: 40% Width (5 cols) Clinic Info & Social Proof Card -->
      <div class="lg:col-span-5 bg-surface-container-lowest rounded-2xl p-6 sm:p-8 shadow-md border border-[#E2DFD7] flex flex-col justify-between h-full">
        <div>
          <div class="inline-flex items-center gap-space-xs bg-primary-fixed text-primary px-space-sm py-1 rounded font-label-sm text-label-sm uppercase font-bold mb-space-md">
            SEDE {SITE_CONFIG.neighborhood.toUpperCase()} • ATENCIÓN PRESENCIAL
          </div>
          <h3 class="font-headline-lg-mobile lg:font-headline-lg text-headline-lg-mobile lg:text-headline-lg uppercase text-on-surface mb-space-md">
            ATENCIÓN PRESENCIAL Y CONTACTO
          </h3>

          <div class="space-y-space-md mb-space-lg">
            <!-- Location -->
            <div class="flex items-start gap-space-md">
              <div class="w-10 h-10 rounded-lg bg-surface-container-low text-primary-container flex items-center justify-center shrink-0">
                <span class="material-symbols-outlined text-headline-sm">location_on</span>
              </div>
              <div>
                <h4 class="font-headline-sm text-headline-sm uppercase text-on-surface leading-tight">Ubicación</h4>
                <p class="font-body-md text-body-md text-on-surface-variant font-medium mt-0.5">
                  {SITE_CONFIG.address}, {SITE_CONFIG.neighborhood}
                </p>
                <p class="font-label-sm text-label-sm text-secondary">Fácil acceso y zona segura de parqueo</p>
              </div>
            </div>

            <!-- Direct phone -->
            <div class="flex items-start gap-space-md">
              <div class="w-10 h-10 rounded-lg bg-surface-container-low text-primary-container flex items-center justify-center shrink-0">
                <span class="material-symbols-outlined text-headline-sm">call</span>
              </div>
              <div>
                <h4 class="font-headline-sm text-headline-sm uppercase text-on-surface leading-tight">Línea Directa</h4>
                <a
                  class="font-body-lg text-body-lg text-primary-container font-bold hover:underline inline-block mt-0.5 whitespace-nowrap"
                  href={SITE_CONFIG.links.phoneCall}
                >
                  📞 {SITE_CONFIG.phoneDisplay}
                </a>
                <p class="font-label-sm text-label-sm text-secondary">Atención telefónica y WhatsApp habilitado</p>
              </div>
            </div>

            <!-- Schedule -->
            <div class="flex items-start gap-space-md">
              <div class="w-10 h-10 rounded-lg bg-surface-container-low text-primary-container flex items-center justify-center shrink-0">
                <span class="material-symbols-outlined text-headline-sm">schedule</span>
              </div>
              <div>
                <h4 class="font-headline-sm text-headline-sm uppercase text-on-surface leading-tight">
                  Horario de Consulta
                </h4>
                <p class="font-body-md text-body-md text-on-surface-variant mt-0.5">
                  <strong>{SITE_CONFIG.schedule.weekdaysLabel}</strong><br />
                  <strong>{SITE_CONFIG.schedule.saturdayLabel}</strong>
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- Tarjeta: Síguenos y mira casos reales (Antes y Después) -->
        <div class="border border-slate-200 rounded-xl p-4 bg-slate-50 mb-5">
          <h4 class="font-headline-sm text-[18px] font-bold uppercase text-primary-container mb-3 flex items-center gap-2">
            <span class="material-symbols-outlined text-[20px]">photo_camera</span>
            <span>Síguenos en redes sociales</span>
          </h4>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
            <!-- Instagram con SVG en degradado oficial -->
            <a
              href={SITE_CONFIG.socialProfiles.instagram.url}
              target="_blank"
              rel="noopener noreferrer"
              class="bg-white border border-slate-200 hover:border-primary-container px-3 py-2.5 rounded-lg flex items-center gap-2.5 no-underline transition-all shadow-sm"
            >
              <svg class="w-5 h-5 shrink-0" viewBox="0 0 24 24">
                <defs>
                  <linearGradient id="ig-grad" x1="0%" y1="100%" x2="100%" y2="0%">
                    <stop offset="0%" stop-color="#f09433"></stop>
                    <stop offset="25%" stop-color="#e6683c"></stop>
                    <stop offset="50%" stop-color="#dc2743"></stop>
                    <stop offset="75%" stop-color="#cc2366"></stop>
                    <stop offset="100%" stop-color="#bc1888"></stop>
                  </linearGradient>
                </defs>
                <path
                  fill="url(#ig-grad)"
                  d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"
                ></path>
              </svg>
              <div class="leading-tight min-w-0">
                <strong class="block text-[13px] text-gray-900 truncate">
                  {SITE_CONFIG.socialProfiles.instagram.name}
                </strong>
                <span class="text-[11px] text-gray-500 whitespace-nowrap">
                  {SITE_CONFIG.socialProfiles.instagram.handle}
                </span>
              </div>
            </a>

            <!-- TikTok -->
            <a
              href={SITE_CONFIG.socialProfiles.tiktok.url}
              target="_blank"
              rel="noopener noreferrer"
              class="bg-white border border-slate-200 hover:border-primary-container px-3 py-2.5 rounded-lg flex items-center gap-2.5 no-underline transition-all shadow-sm"
            >
              <svg class="w-5 h-5 shrink-0 fill-black" viewBox="0 0 24 24">
                <path
                  d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.36 0 .7.07 1.01.2V8.9a6.37 6.37 0 0 0-1.01-.08 6.34 6.34 0 1 0 6.34 6.34V9.08a8.28 8.28 0 0 0 4.76 1.5V7.13a4.8 4.8 0 0 1-1-.44z"
                ></path>
              </svg>
              <div class="leading-tight min-w-0">
                <strong class="block text-[13px] text-gray-900 truncate">
                  {SITE_CONFIG.socialProfiles.tiktok.name}
                </strong>
                <span class="text-[11px] text-gray-500 whitespace-nowrap">
                  {SITE_CONFIG.socialProfiles.tiktok.handle}
                </span>
              </div>
            </a>

            <!-- Facebook -->
            <a
              href={SITE_CONFIG.socialProfiles.facebook.url}
              target="_blank"
              rel="noopener noreferrer"
              class="bg-white border border-slate-200 hover:border-primary-container px-3 py-2.5 rounded-lg flex items-center gap-2.5 no-underline transition-all shadow-sm"
            >
              <svg class="w-5 h-5 shrink-0 fill-[#1877F2]" viewBox="0 0 24 24">
                <path
                  d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"
                ></path>
              </svg>
              <div class="leading-tight min-w-0">
                <strong class="block text-[13px] text-gray-900 truncate">
                  {SITE_CONFIG.socialProfiles.facebook.name}
                </strong>
                <span class="text-[11px] text-gray-500 whitespace-nowrap">
                  {SITE_CONFIG.socialProfiles.facebook.handle}
                </span>
              </div>
            </a>

            <!-- WhatsApp Directo -->
            <a
              href={SITE_CONFIG.socialProfiles.whatsapp.url}
              target="_blank"
              rel="noopener noreferrer"
              class="bg-white border border-slate-200 hover:border-[#25D366] px-3 py-2.5 rounded-lg flex items-center gap-2.5 no-underline transition-all shadow-sm"
            >
              <svg class="w-5 h-5 shrink-0 fill-[#25D366]" viewBox="0 0 24 24">
                <path
                  d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"
                ></path>
              </svg>
              <div class="leading-tight min-w-0">
                <strong class="block text-[13px] text-gray-900 truncate">
                  {SITE_CONFIG.socialProfiles.whatsapp.name}
                </strong>
                <span class="text-[11px] text-gray-500 whitespace-nowrap">
                  {SITE_CONFIG.socialProfiles.whatsapp.handle}
                </span>
              </div>
            </a>
          </div>
        </div>

        <div class="bg-surface-container-low p-space-md rounded-xl border border-[#E2DFD7]">
          <div class="flex items-center gap-space-sm mb-space-xs">
            <span class="material-symbols-outlined text-primary-container text-title-md">verified_user</span>
            <span class="font-label-md text-label-md uppercase text-on-surface font-bold">Compromiso Clínico</span>
          </div>
          <p class="font-body-md text-body-md text-on-surface-variant leading-relaxed">
            Odontólogos Certificados • Respuesta inmediata en menos de 15 minutos en horario hábil para confirmar o reprogramar tu espacio.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
