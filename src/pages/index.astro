---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import TrustBar from '../components/TrustBar.astro';
import Services from '../components/Services.astro';
import HowWeWork from '../components/HowWeWork.astro';
import BookingSection from '../components/BookingSection.astro';
import Testimonials from '../components/Testimonials.astro';
import Faq from '../components/Faq.astro';
import Location from '../components/Location.astro';
import Footer from '../components/Footer.astro';
import FloatingConversionBar from '../components/FloatingConversionBar.astro';
---

<Layout>
  <Header />
  <main class="w-full pt-16 lg:pt-20 bg-surface-container-low flex-1">
    <div class="flex flex-col w-full">
      <Hero />
      <TrustBar />
      <Services />
      <HowWeWork />
      <BookingSection />
      <Testimonials />
      <Faq />
      <Location />
      <Footer />
    </div>
  </main>
  <FloatingConversionBar />
</Layout>
